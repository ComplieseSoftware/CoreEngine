; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
AppName=Pong
AppVersion=1.0
AppPublisher=Compliese Software
DefaultDirName={localappdata}\Programs\Pong
PrivilegesRequired=lowest
DefaultGroupName=Pong
AllowNoIcons=yes
OutputDir=userdesktop
OutputBaseFilename=Pong_Setup
Compression=lzma
SolidCompression=yes
WizardStyle=modern
DisableWelcomePage=no

; Картинки оформления
SetupIconFile=N:\CoreEngine\materials\icon256x256.ico
WizardImageFile=N:\CoreEngine\materials\banner.bmp
WizardSmallImageFile=N:\CoreEngine\materials\small_logo.bmp
WizardImageStretch=yes

[Languages]
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "N:\CoreEngine\x64\Release\Pong.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "N:\CoreEngine\x64\Release\Shaders\*"; DestDir: "{app}\Shaders"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "N:\CoreEngine\x64\Release\materials\*"; DestDir: "{app}\materials"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "N:\CoreEngine\x64\Release\sounds\*"; DestDir: "{app}\sounds"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\Pong"; Filename: "{app}\Pong.exe"; WorkingDir: "{app}"
Name: "{autodesktop}\Pong"; Filename: "{app}\Pong.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\Pong.exe"; Description: "{cm:LaunchProgram,Pong}"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent
